  "narrative": {
    "northStar": "The Flyer Turned Order Screen",
    "overview": "The catalogue is the shop's own flyer set made operable. The world is pinned by the client's artwork: chocolate-brown fields against warm cream, hand-cut heavy lettering with a pale outline, a heart as the only ornament, and the dashed information panel of the flyers.",
    "keyCharacteristics": [
      "Brown and cream carry structure; strawberry red is rationed to prices, the add action, counts, hearts, errors and focus.",
      "Londrina Solid caps for titles, prices and totals; Nunito for everything read.",
      "Pill controls, softly rounded cards, 44px minimum touch targets.",
      "Flat, warm-tinted depth: diffuse brown shadows, no hard offsets.",
      "Heart is the only ornament."
    ],
    "rules": [
      { "name": "The Strawberry Reserve Rule", "body": "Red marks money and the commit action. If an element is neither a price, an add/send control, a count, a heart or an error, it is brown or cream.", "section": "colors" },
      { "name": "The Warm Neutrals Rule", "body": "Every neutral is a brown or cream tint; shadows are tinted with the brown, never neutral gray.", "section": "colors" },
      { "name": "The Outlined Lettering Rule", "body": "Large Londrina on a field carries a thick stroke in the field's neighbour tone with paint-order stroke. Small Londrina (prices, group titles) stays unstroked.", "section": "typography" },
      { "name": "The Numerals Rule", "body": "Every figure is tabular-nums; every price is Londrina.", "section": "typography" },
      { "name": "The Tinted Shadow Rule", "body": "Shadows are diffuse with negative spread and brown; no hard offsets, no glows.", "section": "elevation" }
    ],
    "dos": [
      "Do keep prices in Londrina, tabular, morango on cream (#b5302a) and creme on chocolate.",
      "Do make brown fields (cacau #47301c) and cream ground the structural split; use paper (#fff8f1) for raised cards.",
      "Do show every size with its own price on the card; selection state is solid cacau.",
      "Do keep touch targets at 44px or larger and use the 3px morango focus ring (creme on brown surfaces).",
      "Do wrap motion in prefers-reduced-motion: no-preference.",
      "Do use the heart as the single ornament."
    ],
    "donts": [
      "Don't use morango for decoration, headings or large fills outside the add/send controls.",
      "Don't introduce serif display type, pastel palettes, cool grays, pure black or pure white.",
      "Don't use hard offset shadows, gradient text or glass effects; depth is tonal plus the tinted shadows above.",
      "Don't add ornaments other than the heart, or invent shop facts (delivery, hours, testimonials); content comes from the flyers."
    ]
  }
